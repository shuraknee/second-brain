@@ -0,0 +1,34 @@
+// Offline build: reject external targets before calling browser transport APIs.
+const scope = globalThis as any;
+if (!scope.__silverbulletOfflineNetwork) {
+  scope.__silverbulletOfflineNetwork = true;
+  const origin = scope.location.origin;
+  const check = (input: any) => {
+    const url = new URL(input instanceof Request ? input.url : String(input), scope.location.href);
+    if (url.protocol === "data:" || (url.protocol === "blob:" && url.origin === origin)) return;
+    const normalOrigin = url.origin.replace(/^ws:/, "http:").replace(/^wss:/, "https:");
+    if (normalOrigin !== origin || !["http:", "https:", "ws:", "wss:"].includes(url.protocol)) {
+      throw new Error("Offline build: external network operation removed");
+    }
+  };
+  if (scope.fetch) {
+    const native = scope.fetch.bind(scope);
+    scope.fetch = (input: any, init?: any) => { check(input); return native(input, init); };
+  }
+  for (const name of ["WebSocket", "EventSource"]) {
+    if (scope[name]) {
+      const Native = scope[name];
+      scope[name] = new Proxy(Native, { construct(target, args) { check(args[0]); return Reflect.construct(target, args); } });
+    }
+  }
+  if (scope.XMLHttpRequest) {
+    const open = scope.XMLHttpRequest.prototype.open;
+    scope.XMLHttpRequest.prototype.open = function(method: any, url: any, ...args: any[]) {
+      check(url); return open.call(this, method, url, ...args);
+    };
+  }
+  if (scope.navigator?.sendBeacon) {
+    const beacon = scope.navigator.sendBeacon.bind(scope.navigator);
+    scope.navigator.sendBeacon = (url: any, data: any) => { check(url); return beacon(url, data); };
+  }
+}
