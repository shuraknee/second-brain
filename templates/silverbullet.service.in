# Generated by tools/install.py from the selected target and interpreter.
[Unit]
Description=SilverBullet offline server (isolated)

[Service]
Type=simple
ExecStart=@EXEC_START@
UMask=0077
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateUsers=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
KillMode=control-group
TimeoutStopSec=15
Restart=no

# The installer tests this profile in a transient unit before applying it.
# Runtime independently rejects host networking. No unrestricted fallback.

[Install]
WantedBy=default.target
