# Generated by tools/install.py from the selected target and interpreter.
[Unit]
Description=SilverBullet offline server (seccomp)

[Service]
Type=simple
ExecStart=@EXEC_START@
UMask=0077
NoNewPrivileges=yes
KillMode=control-group
TimeoutStopSec=15
Restart=no

# The installer tests this profile in a transient unit before applying it.
# SilverBullet and Git inherit the no-connect seccomp filter from service.py.
# No namespaces or capability changes are requested from the user manager.

[Install]
WantedBy=default.target
