# Generated by tools/install.py. The trusted relay uses a fixed Unix socket.
# It connects only to the fixed filesystem socket, never to an IP upstream.
[Unit]
Description=SilverBullet fixed Unix-socket ingress
Requires=@SERVER_UNIT@
After=@SERVER_UNIT@

[Service]
Type=simple
ExecStart=@EXEC_START@
UMask=0077
NoNewPrivileges=yes
KillMode=control-group
Restart=no

[Install]
WantedBy=default.target
